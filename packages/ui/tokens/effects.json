{
  "shadows": {
    "none": {
      "shadowColor": "#000000",
      "shadowOpacity": 0,
      "shadowRadius": 0,
      "shadowOffset": { "width": 0, "height": 0 },
      "elevation": 0
    },
    "sm": {
      "shadowColor": "#000000",
      "shadowOpacity": 0.18,
      "shadowRadius": 3,
      "shadowOffset": { "width": 0, "height": 2 },
      "elevation": 2
    },
    "md": {
      "shadowColor": "#000000",
      "shadowOpacity": 0.22,
      "shadowRadius": 6,
      "shadowOffset": { "width": 0, "height": 4 },
      "elevation": 4
    },
    "lg": {
      "shadowColor": "#000000",
      "shadowOpacity": 0.28,
      "shadowRadius": 10,
      "shadowOffset": { "width": 0, "height": 7 },
      "elevation": 8
    }
  },
  "state": {
    "pressedOpacity": 0.6,
    "hoverOpacity": 0.9,
    "disabledOpacity": 0.4
  },
  "motion": {
    "duration": {
      "fast": 120,
      "base": 200,
      "slow": 360
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "decelerate": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0.0, 1, 1)"
    }
  },
  "components": {
    "button": {
      "borderWidth": 1,
      "focusRing": 3
    }
  }
}
