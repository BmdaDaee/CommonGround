OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_STREAM_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=500

# Optional: persist sessions in Firebase instead of memory
SESSION_STORE=memory

# Firebase Admin credentials (recommended for local dev)
FIREBASE_PROJECT_ID=commonground-ccfc8
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@commonground-ccfc8.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: use a non-default Firestore databaseId (most projects should leave this alone)
# FIREBASE_FIRESTORE_DB=(default)

PORT=3001
# Dev backend lock:
# - unset: use Firebase/Firestore (default)
# - supabase: lock dev API to supabase adapter and block firestore access with [firestore-lock]
DEV_BACKEND_LOCK=
