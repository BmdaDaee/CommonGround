# Optional: enables real OpenAI responses; app falls back to echo responses when omitted.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_STREAM_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=500

# Optional: memory (default) or firebase.
SESSION_STORE=memory

# Required only when SESSION_STORE=firebase.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-admin-key.json
FIRESTORE_DATABASE_ID=(default)

# Optional server port.
PORT=3001
