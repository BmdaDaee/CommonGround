rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isPairMember(pairId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/pairs/$(pairId)) &&
        get(/databases/$(database)/documents/pairs/$(pairId)).data.members[request.auth.uid] != null;
    }

    // Treat a member as "active" only if they haven't left.
    function isActivePairMember(pairId) {
      return isPairMember(pairId) &&
        get(/databases/$(database)/documents/pairs/$(pairId)).data.members[request.auth.uid].leftAt == null;
    }

    // Users can only read/write their own user doc.
    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    // Pair (relationship) root doc.
    match /pairs/{pairId} {
      // Members may read the pair, but writes happen via the API (Firebase Admin bypasses rules).
      allow read: if isActivePairMember(pairId);
      allow create, update, delete: if false;

      // Pair-scoped profiles (optional extension). Keep them member-only.
      match /profiles/{uid} {
        // Users can manage their own pair-scoped profile.
        // Partners can read each other's pair profile.
        allow read: if isActivePairMember(pairId);
        allow create, update: if isSelf(uid) && isActivePairMember(pairId);
        allow delete: if false;
      }

      // Messages subcollection: member-only; create only as yourself; no edits.
      match /messages/{messageId} {
        allow read: if isActivePairMember(pairId);

        // Chat writes are server-only in Phase 1.
        allow create, update, delete: if false;
      }
    }
  }
}
